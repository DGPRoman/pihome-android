<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">pihome</string>

    <!-- Signed out -->
    <string name="not_connected">Not connected to a hub yet</string>
    <string name="welcome_body">Ask whoever looks after your hub for an invitation, and scan its QR code with this phone\'s camera. The page it opens hands the invitation to this app.</string>

    <!-- Signed out: the ways in -->
    <string name="paste_invitation">Paste an invitation link</string>
    <string name="log_in_with_password">Log in with a password</string>
    <string name="not_an_invitation">That is not an invitation to a hub. Ask for the code or the link again.</string>

    <!-- An invitation opened while this phone is signed in -->
    <string name="incoming_title">Use this invitation?</string>
    <!-- %1$s is the hub's address, %2$s the account this phone is signed in as -->
    <string name="incoming_body">This phone is connected to %1$s as %2$s. Joining with the invitation signs it out of that account.</string>
    <string name="incoming_use">Use the invitation</string>
    <string name="incoming_keep">Keep this account</string>
    <string name="dismiss">OK</string>

    <!-- Pasting an invitation link -->
    <string name="paste_title">Paste an invitation</string>
    <string name="invitation_link">Invitation link</string>
    <string name="paste_blank">Paste the link from your invitation.</string>
    <string name="continue_button">Continue</string>

    <!-- What is wrong with an address, typed or inside a link -->
    <string name="address_blank">Enter the hub\'s address.</string>
    <string name="address_invalid">That is not an address. It looks like hub.local:5002.</string>
    <string name="address_not_http">A hub\'s address starts with http:// or https://.</string>
    <string name="address_more">Only the hub\'s address, with nothing after it.</string>
    <string name="address_public_http">Plain http:// is only for addresses on your home network. Use https:// for this one.</string>

    <!-- Reaching a hub -->
    <string name="checking_hub">Checking the hub…</string>
    <string name="try_again">Try again</string>
    <string name="error_offline">The hub did not answer. Check the address, and that this phone is on the same network as the hub.</string>
    <string name="error_timeout">The hub did not answer in time. Try again in a moment.</string>
    <string name="error_insecure">This address leads outside your home network, where plain http:// is not safe. Use https:// for it.</string>
    <string name="error_not_the_hub">Something answered that is not a hub. Check the address, and whether this Wi-Fi wants you to sign in first.</string>
    <string name="error_rate_limited">The hub is refusing further attempts for now. Wait a few minutes.</string>
    <string name="error_server">The hub failed while handling that. Try again later.</string>
    <string name="error_other">Something went wrong while talking to the hub. Try again.</string>

    <!-- Leave to reach the local network (Android 17 and later) -->
    <string name="permission_title">Access to your home network</string>
    <string name="permission_body">Your hub is on the network this phone is connected to. Android asks before an app reaches devices there, so it will ask you next.</string>
    <string name="permission_refused">Without access to devices on your network, this app cannot reach your hub. Allow it in this app\'s permissions in the settings.</string>
    <string name="permission_ask_again">Ask again</string>
    <string name="open_settings">Open settings</string>

    <!-- Joining with an invitation -->
    <string name="join_title">Join a hub</string>
    <!-- %1$s is the hub's address, such as http://hub.local:5002 -->
    <string name="join_body">This invitation connects this phone to the hub at %1$s. It works once.</string>
    <string name="join_button">Join</string>
    <string name="joining">Joining…</string>
    <string name="join_expired">This invitation is more than 15 minutes old, so it has run out. Ask whoever sent it for a new one.</string>
    <string name="join_refused">This invitation does not work any more. Ask whoever sent it for a new one.</string>
    <string name="join_lost">No usable answer came back, so the invitation may already have been used. Ask whoever sent it for a new one.</string>
    <string name="back_to_start">Back to start</string>

    <!-- Logging in with a password -->
    <string name="log_in_title">Log in</string>
    <string name="hub_address">Hub address</string>
    <string name="username">Username</string>
    <string name="password">Password</string>
    <string name="log_in_button">Log in</string>
    <string name="logging_in">Checking the password…</string>
    <string name="no_username">Enter your username.</string>
    <string name="no_password">Enter your password.</string>
    <string name="log_in_refused">The hub did not accept that username and password.</string>

    <!-- The house -->
    <string name="house_title">House</string>
    <string name="showing_last">Showing what the hub last reported.</string>

    <!-- The house: relays -->
    <string name="relays_title">Relays</string>
    <string name="relays_loading">Reading the relays…</string>
    <string name="relays_empty">No relays are set up on the hub.</string>
    <string name="relay_on">On</string>
    <string name="relay_off">Off</string>
    <!-- The switch was pressed and no usable answer came back: probably on, not confirmed -->
    <string name="relay_on_unsure">On?</string>
    <string name="relay_off_unsure">Off?</string>
    <!-- What a screen reader says of a switch in that state -->
    <string name="relay_probably_on">On, not confirmed</string>
    <string name="relay_probably_off">Off, not confirmed</string>
    <string name="relay_unconfirmed">No usable answer came back, so the switch may have moved. Checking with the hub.</string>
    <string name="relay_forbidden">Your account may not change this.</string>
    <!-- %1$s is a time of day, such as 23:15 -->
    <string name="relay_hold_off">An automation rule switches it off at %1$s.</string>
    <string name="relay_hold_on">An automation rule switches it on at %1$s.</string>
    <string name="read_only">Your account can see the house but not change it. An admin can make it an operator.</string>
    <string name="all_off">All off</string>
    <string name="all_off_unconfirmed">No usable answer came back, so the relays may already be off. Checking with the hub.</string>

    <!-- The house: sensors -->
    <string name="sensors_title">Sensors</string>
    <string name="sensors_loading">Reading the sensors…</string>
    <string name="sensors_empty">No sensors are set up on the hub.</string>
    <string name="stale">Stale</string>
    <string name="never_reported">Never reported</string>
    <string name="no_readings">No readings yet.</string>
    <string name="age_unknown">age unknown</string>
    <!-- %1$s is how long ago, such as "5 minutes ago" -->
    <string name="last_seen">Last seen %1$s</string>
    <string name="motion">Motion</string>
    <string name="motion_detected">Detected</string>
    <string name="motion_clear">Clear</string>
    <string name="temperature">Temperature</string>
    <string name="humidity">Humidity</string>
    <!-- %1$s is a number, such as 21.5 -->
    <string name="temperature_value">%1$s °C</string>
    <string name="humidity_value">%1$s %%</string>

    <!-- How long ago -->
    <string name="just_now">just now</string>
    <plurals name="seconds_ago">
        <item quantity="one">%d second ago</item>
        <item quantity="other">%d seconds ago</item>
    </plurals>
    <plurals name="minutes_ago">
        <item quantity="one">%d minute ago</item>
        <item quantity="other">%d minutes ago</item>
    </plurals>
    <plurals name="hours_ago">
        <item quantity="one">%d hour ago</item>
        <item quantity="other">%d hours ago</item>
    </plurals>
    <plurals name="days_ago">
        <item quantity="one">%d day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>

    <!-- The house: devices the hub polls -->
    <string name="devices_title">Devices</string>
    <string name="devices_loading">Reading the devices…</string>
    <string name="devices_empty">No devices are set up on the hub.</string>
    <string name="device_silent">Not answering</string>
    <string name="device_never_announced">Never announced</string>
    <string name="device_not_polled">Not asked yet</string>
    <string name="device_never_announced_body">It is set up on the hub and has never said where it is. Either it is not switched on, or it cannot reach the hub.</string>
    <!-- %1$s is how long ago, such as "5 minutes ago" -->
    <string name="device_announced">announced %1$s</string>
    <string name="device_unreachable">The hub could not reach it.</string>
    <string name="device_silent_since">It stopped answering %1$s.</string>
    <string name="device_reported">Reported %1$s</string>
    <string name="device_last_answered">Last answered %1$s</string>
    <string name="device_reported_unknown">When it reported this is not known.</string>

    <!-- The house: automation rules -->
    <string name="rules_title">Automation</string>
    <string name="rules_loading">Reading the rules…</string>
    <string name="rules_empty">No automation rules are set up on the hub.</string>
    <string name="rule_disabled">Disabled</string>
    <string name="rule_after_dark">After dark</string>
    <!-- %1$s is a sensor's name -->
    <string name="rule_when_motion">When %1$s detects motion</string>
    <string name="rule_when_still">When %1$s reports no motion</string>
    <!-- %1$s is a relay's name -->
    <string name="rule_turn_on">switch on %1$s</string>
    <string name="rule_turn_off">switch off %1$s</string>
    <!-- %1$s is when ("When the porch sensor detects motion"), %2$s is what ("switch on the porch light") -->
    <string name="rule_sentence">%1$s, %2$s.</string>
    <!-- As above, and %3$s is how long, such as "2 minutes" -->
    <string name="rule_sentence_hold">%1$s, %2$s, and put it back after %3$s.</string>
    <plurals name="span_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>
    <plurals name="span_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="span_hours">
        <item quantity="one">%d hour</item>
        <item quantity="other">%d hours</item>
    </plurals>

    <!-- Account -->
    <string name="account_title">Account</string>
    <string name="account_hub">Hub</string>
    <string name="account_name">Name</string>
    <string name="account_role">Role</string>
    <string name="role_admin">Admin</string>
    <string name="role_operator">Operator</string>
    <string name="role_viewer">Viewer</string>
    <string name="account_session_ends">Session ends</string>
    <string name="session_ends_today">It ends within a day. Opening the app on your home network renews it.</string>
    <plurals name="session_ends_in_days">
        <item quantity="one">It ends in %d day. Opening the app on your home network renews it.</item>
        <item quantity="other">It ends in %d days. Opening the app on your home network renews it.</item>
    </plurals>
    <string name="account_version">App version</string>
    <string name="sign_out">Sign out</string>

    <!-- The hub stopped accepting the session -->
    <string name="session_ended_title">Your session has ended</string>
    <string name="session_ended_body">The hub no longer accepts this phone. The session may have run out, or the account may have been disabled or removed. Ask for a new invitation to connect again.</string>
    <string name="session_ended_continue">OK</string>

    <string name="navigate_up">Back</string>
</resources>
