<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 and later: leave to reach devices on the network the phone is
         on, which is where a hub usually is. Asked for when it is needed. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- No backup and no device-to-device transfer. What this app keeps is one hub
         address and one session, and the session is not something to carry to
         another phone: a new phone joins with an invitation of its own. -->
    <application
        android:name=".PihomeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pihome">

        <!-- singleTop, so an invitation opened while the app is showing reaches
             the one there is, in onNewIntent, rather than a second copy of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An invitation, handed over by the hub's join page:
                 pihome://join?hub=<hub origin>&token=<invitation>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="join"
                    android:scheme="pihome" />
            </intent-filter>
        </activity>

        <!-- The Quick Settings tile. Only the system may bind to it. -->
        <service
            android:name=".quick.RelayTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- On or off, so a screen reader calls it a switch. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
